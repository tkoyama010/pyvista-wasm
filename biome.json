{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["ts/**/*.ts", "*.js", "*.json", "*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "semicolons": "always"
    },
    "globals": []
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noAstroConflictingSetDirectives": "error",
        "noAstroSetHtmlDirective": "error",
        "noBaseToString": "error",
        "noBunModules": "error",
        "noDoubleComparison": "error",
        "noDuplicateMapKeys": "error",
        "noExcessiveStatementsPerFunction": "off",
        "noExtendNative": "error",
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noInvalidFileInputAccept": "error",
        "noInvalidPropertyInitValue": "error",
        "noInvalidThis": "error",
        "noJsRestrictedProperties": "error",
        "noJsonUnsafeValues": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "error",
        "noMisplacedListElements": "error",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "error",
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noNonScalableViewport": "error",
        "noObjectConstructor": "error",
        "noObsoleteTags": "error",
        "noOctal": "error",
        "noProcessExit": "error",
        "noPromiseExecutorReturn": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noRestrictedDependencies": "error",
        "noReturnInFinally": "error",
        "noSelfImport": "error",
        "noSvelteAddEventListener": "error",
        "noSvelteAtDebugTags": "error",
        "noSvelteAtHtmlTags": "error",
        "noSvelteClassDirective": "error",
        "noSvelteExportLet": "error",
        "noSvelteInspect": "error",
        "noSvelteLegacyConst": "error",
        "noSvelteObjectInTextMustaches": "error",
        "noSvelteUnnecessaryStateWrap": "error",
        "noSvelteUselessDerivedBy": "error",
        "noTailwindArbitraryValue": "error",
        "noTailwindLegacyUtilities": "error",
        "noTailwindRawColors": "error",
        "noTailwindRestyledComponents": "error",
        "noThisOutsideOfClass": "error",
        "noUndeclaredClasses": "error",
        "noUndeclaredCustomProperties": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnsafeIframeSandbox": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeUnaryMinus": "error",
        "noUnusedClasses": "error",
        "noUselessAssignment": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "noUselessTypeConversion": "error",
        "noVueBooleanDefault": "error",
        "noVueDeprecatedScopedSlots": "error",
        "noVueLifecycleAfterAwait": "error",
        "noVueRequiredPropWithDefault": "error",
        "noVueRootVIf": "error",
        "noVueShadowNativeEvents": "error",
        "noVueUndeclaredDirectives": "error",
        "noVueVHtml": "error",
        "noVueVText": "error",
        "noXorAsExponentiation": "error",
        "noZeroFractions": "error",
        "useAstroClientOnlyDirectiveValue": "error",
        "useAwaitThenable": "error",
        "useBetterDomTraversing": "error",
        "useBigintLiterals": "error",
        "useCapitalizedConstructors": "error",
        "useConsistentBlockLang": "error",
        "useConsistentHeadingLevel": "error",
        "useConsistentJsonFileRead": "error",
        "useConsistentObjectKeys": "error",
        "useControlLabel": "error",
        "useDisposables": "error",
        "useExhaustiveSwitchCases": "error",
        "useExplicitReturnType": "error",
        "useExplicitType": "error",
        "useFencedCodeLanguage": "error",
        "useFlatMathMinMax": "error",
        "useIncludes": "error",
        "useLayeredStyles": "error",
        "useLogicalProperties": "error",
        "useLowercaseTestTitle": "error",
        "useModernMathApis": "error",
        "useNamedFunction": "error",
        "useNamedLayer": "error",
        "useNullishCoalescing": "error",
        "usePromiseRejectErrors": "error",
        "useReactCompiler": "error",
        "useReactFunctionComponentDefinition": "error",
        "useReactNamingConvention": "error",
        "useRegexpExec": "error",
        "useSimplifiedBooleanReturn": "error",
        "useSingleTopLevelHeading": "error",
        "useStrictBooleanExpressions": "error",
        "useStringStartsEndsWith": "error",
        "useSvelteKitResolve": "error",
        "useSvelteKitRuneImports": "error",
        "useSvelteReactiveClasses": "error",
        "useSvelteRequireEachKey": "error",
        "useSvelteShorthandDirective": "error",
        "useTailwindShorthandClasses": "error",
        "useTailwindSortedClasses": "error",
        "useTailwindStaticClassStrings": "error",
        "useTopLevelHeading": "error",
        "useUnaryMinus": "error",
        "useValidTestTitle": "error",
        "useVueBaseImport": "error",
        "useVueConsistentEventHyphenation": "error",
        "useVueMatchingComponentFileName": "error"
      },
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "includes": ["ts/renderer.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off",
            "noVoid": "off"
          },
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "nursery": {
            "noUnsafeTypeAssertion": "off",
            "useConsistentFunctionStyle": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noIncrementDecrement": "off",
            "noNestedTernary": "off",
            "noTernary": "off"
          }
        }
      }
    },
    {
      "includes": ["ts/vtk.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
            "useConsistentMethodSignatures": "off",
            "useNamingConvention": "off",
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    }
  ]
}
