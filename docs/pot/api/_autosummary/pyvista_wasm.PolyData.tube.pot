#: ../api/_autosummary/pyvista_wasm.PolyData.tube.rst:2
msgid "pyvista\\_wasm.PolyData.tube"
msgstr ""

#: ../../src/pyvista_wasm/mesh.py:docstring of pyvista_wasm.mesh.PolyData.tube:1
msgid "Generate a tube around a line polydata."
msgstr ""

#: ../../src/pyvista_wasm/mesh.py:docstring of pyvista_wasm.mesh.PolyData.tube:3
msgid "This filter creates a tube representation around lines in the mesh by sweeping a polygonal cross-section along each line. It mirrors the PyVista ``tube`` filter API and is backed by VTK.wasm's ``vtkTubeFilter``."
msgstr ""

#: ../../src/pyvista_wasm/mesh.py:docstring of pyvista_wasm.mesh.PolyData.tube:10
msgid "This filter is intended for use with line-based polydata (such as the output of :class:`Line`). It uses VTK.wasm's ``vtkTubeFilter``, which generates a tube by sweeping a circle with ``n_sides`` sides along the line segments."
msgstr ""

#: ../api/_autosummary/pyvista_wasm.PolyData.tube.rst:0
msgid "Parameters"
msgstr ""

#: ../../src/pyvista_wasm/mesh.py:docstring of pyvista_wasm.mesh.PolyData.tube:15
msgid "The radius of the tube. Default is 0.5."
msgstr ""

#: ../../src/pyvista_wasm/mesh.py:docstring of pyvista_wasm.mesh.PolyData.tube:17
msgid "The number of sides for the tube cross-section. Higher values produce smoother tubes. Default is 20."
msgstr ""

#: ../../src/pyvista_wasm/mesh.py:docstring of pyvista_wasm.mesh.PolyData.tube:20
msgid "Whether to cap the ends of the tube. Default is True."
msgstr ""

#: ../api/_autosummary/pyvista_wasm.PolyData.tube.rst:0
msgid "Returns"
msgstr ""

#: ../../src/pyvista_wasm/mesh.py:docstring of pyvista_wasm.mesh.PolyData.tube:23
msgid "A new mesh representing the tube."
msgstr ""

