msgid "MADR 4.0.0 release: [https://github.com/adr/madr/releases/tag/4.0.0](https://github.com/adr/madr/releases/tag/4.0.0)"
msgstr ""

#: ../decisions/0000-use-markdown-architectural-decision-records.md:100
msgid "MADR template (development): [https://github.com/adr/madr/blob/develop/template/adr-template.md](https://github.com/adr/madr/blob/develop/template/adr-template.md)"
msgstr ""

#: ../decisions/0000-use-markdown-architectural-decision-records.md:101
msgid "Initialization snippet: `npm install madr && mkdir -p docs/decisions && cp node_modules/madr/template/* docs/decisions/`"
msgstr ""

