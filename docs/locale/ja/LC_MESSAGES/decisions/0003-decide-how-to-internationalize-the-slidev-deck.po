msgid "Two separate decks"
msgstr "2つの個別デッキ"

#: ../../decisions/0003-decide-how-to-internationalize-the-slidev-deck.md
msgid "Inline JA/EN"
msgstr "インライン JA/EN"

#: ../../decisions/0003-decide-how-to-internationalize-the-slidev-deck.md
msgid "Custom vue-i18n"
msgstr "カスタム vue-i18n"

