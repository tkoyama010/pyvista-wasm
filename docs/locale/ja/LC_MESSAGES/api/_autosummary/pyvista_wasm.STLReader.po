#: ../api/_autosummary/pyvista_wasm.STLReader.rst:2
msgid "pyvista\\_wasm.STLReader"
msgstr "pyvista\\_wasm.STLReader"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.STLReader:1
msgid "Reader for STL (STereoLithography) files (``.stl``)."
msgstr "STL（STereoLithography）ファイルのリーダー（``.stl``）。"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.STLReader:3
msgid ""
"Reads an STL file (ASCII or binary) and produces a :class:`Mesh` that "
"delegates parsing to VTK.wasm's ``vtkSTLReader`` at render time. Python "
"extracts only the vertex coordinates so that camera framing and bounding-"
"sphere queries work before rendering."
msgstr ""
"STLファイル（ASCII またはバイナリ）を読み込み、レンダリング時に VTK.wasm の ``vtkSTLReader`` に解析を委譲する "
":class:`Mesh` を生成します。Python "
"は頂点座標のみを抽出するため、カメラフレーミングとバウンディングスフィアのクエリがレンダリング前に機能します。"

#: ../api/_autosummary/pyvista_wasm.STLReader.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.STLReader:8
msgid "Path to the ``.stl`` file."
msgstr "``.stl`` ファイルのパス。"

