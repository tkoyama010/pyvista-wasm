#: ../api/_autosummary/pyvista_wasm.GLTFReader.rst:2
msgid "pyvista\\_wasm.GLTFReader"
msgstr "pyvista\\_wasm.GLTFReader"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.GLTFReader:1
msgid ""
"Reader for glTF (GL Transmission Format) files (``.gltf`` or ``.glb``)."
msgstr "glTF（GL Transmission Format）ファイルのリーダー（``.gltf`` または ``.glb``）。"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.GLTFReader:3
msgid ""
"Reads a glTF file and produces a :class:`Mesh` that delegates parsing to "
"VTK.wasm's ``vtkGLTFImporter`` at render time. Python extracts vertex "
"coordinates from the JSON structure so that camera framing and bounding-"
"sphere queries work before rendering."
msgstr ""
"glTFファイルを読み込み、レンダリング時に VTK.wasm の ``vtkGLTFImporter`` に解析を委譲する :class:`Mesh`"
" を生成します。Python は JSON "
"構造から頂点座標を抽出するため、カメラフレーミングとバウンディングスフィアのクエリがレンダリング前に機能します。"

