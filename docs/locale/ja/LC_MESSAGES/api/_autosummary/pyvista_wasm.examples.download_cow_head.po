#: ../api/_autosummary/pyvista_wasm.examples.download_cow_head.rst:2
msgid "pyvista\\_wasm.examples.download\\_cow\\_head"
msgstr "pyvista\\_wasm.examples.download\\_cow\\_head"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.download_cow_head:1
msgid "Download the cow head dataset."
msgstr "牛の頭のデータセットをダウンロードします。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.download_cow_head:3
msgid ""
"Downloads ``cowHead.vtp`` from the PyVista vtk-data repository and returns "
"it as a :class:`~pyvista_wasm.PolyData` mesh, mirroring the "
"``pyvista.examples.download_cow_head`` API."
msgstr ""
"PyVista vtk-data リポジトリから ``cowHead.vtp`` "
"をダウンロードし、:class:`~pyvista_wasm.PolyData` "
"メッシュとして返します。``pyvista.examples.download_cow_head`` API と同じ動作です。"

#: ../api/_autosummary/pyvista_wasm.examples.download_cow_head.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.download_cow_head:7
msgid ""
"Load the dataset after downloading it. When ``False``, only the path to the "
"downloaded ``.vtp`` file is returned."
msgstr "ダウンロード後にデータセットを読み込みます。``False`` の場合、ダウンロードした ``.vtp`` ファイルのパスのみを返します。"

#: ../api/_autosummary/pyvista_wasm.examples.download_cow_head.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.download_cow_head:11
msgid ""
"The cow head mesh, or the path to the ``.vtp`` file when ``load=False``."
msgstr "牛の頭のメッシュ。``load=False`` の場合は ``.vtp`` ファイルのパス。"

#: ../api/_autosummary/pyvista_wasm.examples.download_cow_head.rst:0
msgid "Return type"
msgstr "戻り値の型"

