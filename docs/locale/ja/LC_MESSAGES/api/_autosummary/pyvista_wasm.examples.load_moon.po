#: ../../api/_autosummary/pyvista_wasm.examples.load_moon.rst:2
msgid "pyvista\\_wasm.examples.load\\_moon"
msgstr "pyvista\\_wasm.examples.load\\_moon"

#: of pyvista_wasm.examples.load_moon:1
msgid "Load the Moon as a textured sphere."
msgstr "テクスチャ付き球体として月をロードします。"

#: of pyvista_wasm.examples.load_moon:3
msgid ""
"Creates a sphere mesh with texture coordinates, matching the "
"``pyvista.examples.planets.load_moon`` API. The sphere is rotated 180° "
"around the Z axis to align the Prime Meridian correctly."
msgstr ""
"テクスチャ座標付きの球体メッシュを作成します。"
"``pyvista.examples.planets.load_moon`` API と一致します。"
"球体は Z 軸周りに 180° 回転され、本初子午線が正しく整列されます。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_moon.rst
msgid "Parameters"
msgstr "パラメータ"

#: of pyvista_wasm.examples.load_moon:7
msgid "Sphere radius. Default is 1.0."
msgstr "球体の半径。デフォルトは 1.0。"

#: of pyvista_wasm.examples.load_moon:9
msgid "Number of points in the latitude direction. Default is 50."
msgstr "緯度方向のポイント数。デフォルトは 50。"

#: of pyvista_wasm.examples.load_moon:11
msgid "Number of points in the longitude direction. Default is 100."
msgstr "経度方向のポイント数。デフォルトは 100。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_moon.rst
msgid "Returns"
msgstr "戻り値"

#: of pyvista_wasm.examples.load_moon:14
msgid "Moon sphere mesh with texture coordinates."
msgstr "テクスチャ座標付き月球体メッシュ。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_moon.rst
msgid "Return type"
msgstr "戻り値の型"

#: of pyvista_wasm.examples.load_moon:19
msgid ":func:`~pyvista_wasm.examples.load_earth`"
msgstr ":func:`~pyvista_wasm.examples.load_earth`"

#: of pyvista_wasm.examples.load_moon:20
msgid "Load the planet Earth for comparison."
msgstr "比較のために地球をロードします。"

#: of pyvista_wasm.examples.load_moon:22
msgid ":func:`~pyvista_wasm.examples.download_moon_surface`"
msgstr ":func:`~pyvista_wasm.examples.download_moon_surface`"

#: of pyvista_wasm.examples.load_moon:23
msgid "Download the Moon surface texture."
msgstr "月表面のテクスチャをダウンロードします。"

