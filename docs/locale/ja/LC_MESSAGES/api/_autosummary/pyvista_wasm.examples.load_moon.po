msgid "Moon sphere mesh with texture coordinates."
msgstr "テクスチャ座標付き月球体メッシュ。"

#: ../api/_autosummary/pyvista_wasm.examples.load_moon.rst:0
msgid "Return type"
msgstr "戻り値の型"

