msgid "pyvista\\_wasm.examples.load\\_neptune"
msgstr "pyvista\\_wasm.examples.load\\_neptune"

#: of pyvista_wasm.examples.load_neptune:1
msgid "Load the planet Neptune as a textured sphere."
msgstr "テクスチャ付き球体として海王星をロードします。"

#: of pyvista_wasm.examples.load_neptune:3
msgid ""
"Creates a sphere mesh with texture coordinates, matching the "
"``pyvista.examples.planets.load_neptune`` API. The sphere is rotated 180°"
" around the Z axis to align the Prime Meridian correctly."
msgstr ""
"テクスチャ座標付きの球体メッシュを作成します。"
"``pyvista.examples.planets.load_neptune`` API と一致します。"
"球体は Z 軸周りに 180° 回転され、本初子午線が正しく整列されます。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_neptune.rst
msgid "Parameters"
msgstr "パラメータ"

#: of pyvista_wasm.examples.load_neptune:7
msgid "Sphere radius. Default is 1.0."
msgstr "球体の半径。デフォルトは 1.0。"

#: of pyvista_wasm.examples.load_neptune:9
msgid "Number of points in the latitude direction. Default is 50."
msgstr "緯度方向のポイント数。デフォルトは 50。"

#: of pyvista_wasm.examples.load_neptune:11
msgid "Number of points in the longitude direction. Default is 100."
msgstr "経度方向のポイント数。デフォルトは 100。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_neptune.rst
msgid "Returns"
msgstr "戻り値"

#: of pyvista_wasm.examples.load_neptune:14
msgid "Neptune sphere mesh with texture coordinates."
msgstr "テクスチャ座標付き海王星球体メッシュ。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_neptune.rst
msgid "Return type"
msgstr "戻り値の型"

#: of pyvista_wasm.examples.load_neptune:19
