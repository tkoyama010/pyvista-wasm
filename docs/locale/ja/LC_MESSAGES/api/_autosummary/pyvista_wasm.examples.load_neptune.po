msgstr ":func:`~pyvista_wasm.examples.load_earth`"

#: of pyvista_wasm.examples.load_neptune:20
msgid "Load the planet Earth for comparison."
msgstr "比較のために地球をロードします。"

#: of pyvista_wasm.examples.load_neptune:22
