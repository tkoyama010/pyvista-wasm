#: ../api/_autosummary/pyvista_wasm.Circle.rst:2
msgid "pyvista\\_wasm.Circle"
msgstr "pyvista\\_wasm.Circle"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Circle:1
msgid "Create a circle defined by a set of points in the XY plane."
msgstr "XY平面上の点集合で定義される円を作成します。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Circle:3
msgid ""
"This mirrors the :func:`pyvista.Circle` API, producing a closed polygon "
"outline of ``resolution`` points lying in the XY plane."
msgstr ""
"これは :func:`pyvista.Circle` API をミラーリングし、XY平面上に配置された ``resolution`` "
"個のポイントからなる閉じたポリゴンアウトラインを生成します。"

#: ../api/_autosummary/pyvista_wasm.Circle.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Circle:6
msgid "Radius of the circle. Default is 0.5."
msgstr "円の半径。デフォルトは0.5。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Circle:8
msgid "Number of points on the circle. Default is 100."
msgstr "円上のポイント数。デフォルトは100。"

#: ../api/_autosummary/pyvista_wasm.Circle.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Circle:11
msgid "A circle mesh (closed polyline in the XY plane)."
msgstr "円メッシュ（XY平面上の閉じたポリライン）。"

#: ../api/_autosummary/pyvista_wasm.Circle.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Circle:15
msgid "Examples"
msgstr "例"
