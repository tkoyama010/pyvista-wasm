#: ../api/_autosummary/pyvista_wasm.Tetrahedron.rst:2
msgid "pyvista\\_wasm.Tetrahedron"
msgstr "pyvista\\_wasm.Tetrahedron"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Tetrahedron:1
msgid "Create a tetrahedron mesh."
msgstr "四面体メッシュを作成します。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Tetrahedron:3
msgid ""
"Mirrors :func:`pyvista.Tetrahedron`. The vertices are placed on a sphere of "
"the given radius, and the four faces are outward-oriented triangles."
msgstr ""
":func:`pyvista.Tetrahedron` と同等の動作です。頂点は指定された半径の球面上に配置され、4つの面は外向きの三角形になります。"

#: ../api/_autosummary/pyvista_wasm.Tetrahedron.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Tetrahedron:7
msgid "Radius of the circumscribed sphere. Default is 1.0."
msgstr "外接球の半径。デフォルトは1.0。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Tetrahedron:9
msgid "Center of the tetrahedron (x, y, z). Default is (0, 0, 0)."
msgstr "四面体の中心 (x, y, z)。デフォルトは (0, 0, 0)。"

#: ../api/_autosummary/pyvista_wasm.Tetrahedron.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Tetrahedron:12
msgid "A tetrahedron mesh."
msgstr "四面体メッシュ。"

#: ../api/_autosummary/pyvista_wasm.Tetrahedron.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Tetrahedron:16
msgid "Examples"
msgstr "例"
