#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn_rings:1
msgid "Load the planet Saturn's rings."
msgstr "土星の環をロードします。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn_rings:3
msgid ""
"Arguments are passed on to :class:`~pyvista_wasm.Disc`, matching the "
"``pyvista.examples.planets.load_saturn_rings`` API. Texture coordinates are "
"set so the ring texture maps radially from the inner to the outer radius."
msgstr ""
" ``pyvista.examples.planets.load_saturn_rings`` API と同じ、引数は "
":class:`~pyvista_wasm.Disc` "
"に渡されます。環のテクスチャが内半径から外半径まで放射状にマッピングされるようにテクスチャ座標が設定されます。"

#: ../api/_autosummary/pyvista_wasm.examples.load_saturn_rings.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn_rings:8
msgid "The inner radius. Default is 0.25."
msgstr "内半径。デフォルトは 0.25。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn_rings:10
msgid "The outer radius. Default is 0.5."
msgstr "外半径。デフォルトは 0.5。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn_rings:12
msgid "The number of points in the circumferential direction. Default is 6."
msgstr "周方向の点数。デフォルトは 6。"

#: ../api/_autosummary/pyvista_wasm.examples.load_saturn_rings.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn_rings:15
msgid "Disc mesh with texture coordinates for Saturn's rings."
msgstr "土星の環のためのテクスチャ座標付きディスクメッシュ。"

#: ../api/_autosummary/pyvista_wasm.examples.load_saturn_rings.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn_rings:20
