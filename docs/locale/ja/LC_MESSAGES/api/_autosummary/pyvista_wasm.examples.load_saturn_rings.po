#: ../../api/_autosummary/pyvista_wasm.examples.load_saturn_rings.rst:2
msgid "pyvista\\_wasm.examples.load\\_saturn\\_rings"
msgstr "pyvista\\_wasm.examples.load\\_saturn\\_rings"

#: of pyvista_wasm.examples.load_saturn_rings:1
msgid "Load the planet Saturn's rings."
msgstr "土星の環をロードします。"

#: of pyvista_wasm.examples.load_saturn_rings:3
msgid ""
"Arguments are passed on to :class:`~pyvista_wasm.Disc`, matching the "
"``pyvista.examples.planets.load_saturn_rings`` API. Texture coordinates "
"are set so the ring texture maps radially from the inner to the outer "
"radius."
msgstr ""
"引数は :class:`~pyvista_wasm.Disc` に渡されます。"
"``pyvista.examples.planets.load_saturn_rings`` API と一致します。"
"環のテクスチャが内側半径から外側半径へ放射状にマッピングされるように"
"テクスチャ座標を設定します。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_saturn_rings.rst
msgid "Parameters"
msgstr "パラメータ"

#: of pyvista_wasm.examples.load_saturn_rings:8
msgid "The inner radius. Default is 0.25."
msgstr "内側の半径。デフォルトは 0.25。"

#: of pyvista_wasm.examples.load_saturn_rings:10
msgid "The outer radius. Default is 0.5."
msgstr "外側の半径。デフォルトは 0.5。"

#: of pyvista_wasm.examples.load_saturn_rings:12
msgid "The number of points in the circumferential direction. Default is 6."
msgstr "円周方向のポイント数。デフォルトは 6。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_saturn_rings.rst
msgid "Returns"
msgstr "戻り値"

#: of pyvista_wasm.examples.load_saturn_rings:15
msgid "Disc mesh with texture coordinates for Saturn's rings."
msgstr "土星の環用テクスチャ座標付きディスクメッシュ。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_saturn_rings.rst
msgid "Return type"
msgstr "戻り値の型"

#: of pyvista_wasm.examples.load_saturn_rings:20
msgid ":func:`~pyvista_wasm.examples.load_saturn`"
msgstr ":func:`~pyvista_wasm.examples.load_saturn`"

#: of pyvista_wasm.examples.load_saturn_rings:21
msgid "Load the planet Saturn."
msgstr "土星をロードします。"

#: of pyvista_wasm.examples.load_saturn_rings:23
msgid ":func:`~pyvista_wasm.examples.download_saturn_rings`"
msgstr ":func:`~pyvista_wasm.examples.download_saturn_rings`"

#: of pyvista_wasm.examples.load_saturn_rings:24
msgid "Download the Saturn rings texture."
msgstr "土星の環のテクスチャをダウンロードします。"

