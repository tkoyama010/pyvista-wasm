#: ../../api/_autosummary/pyvista_wasm.Camera.rst:2
msgid "pyvista\\_wasm.Camera"
msgstr "pyvista\\_wasm.Camera"

#: of pyvista_wasm.camera.Camera:1
msgid "Represents a virtual camera in a 3D scene."
msgstr "3Dシーンの仮想カメラを表します。"

#: of pyvista_wasm.camera.Camera:3
msgid ""
"Provides a PyVista-like API for controlling camera position, orientation,"
" and projection settings in VTK.wasm scenes."
msgstr ""
"VTK.wasm シーンでカメラの位置、向き、投影設定を制御するための PyVista ライクな API を提供します。"

#: ../../api/_autosummary/pyvista_wasm.Camera.rst
msgid "Parameters"
msgstr "パラメータ"

#: of pyvista_wasm.camera.Camera:6
msgid "Camera position as (x, y, z). Default is (0, 0, 1)."
msgstr "カメラの位置 (x, y, z)。デフォルトは (0, 0, 1)。"

#: of pyvista_wasm.camera.Camera:8
msgid "Point the camera looks at as (x, y, z). Default is (0, 0, 0)."
msgstr "カメラが見るポイント (x, y, z)。デフォルトは (0, 0, 0)。"

#: of pyvista_wasm.camera.Camera:10
msgid "View-up vector as (x, y, z). Default is (0, 1, 0)."
msgstr "上方向ベクトル (x, y, z)。デフォルトは (0, 1, 0)。"

#: of pyvista_wasm.camera.Camera:12
msgid "Camera view angle (field of view) in degrees. Default is 30.0."
msgstr "カメラの視野角（度）。デフォルトは30.0。"

#: of pyvista_wasm.camera.Camera:14
msgid ""
"Near and far clipping plane distances as (near, far). Default is (0.01, "
"1000.01)."
msgstr ""
"近接および遠方クリッピング平面の距離 (near, far)。デフォルトは (0.01, 1000.01)。"

#: of pyvista_wasm.camera.Camera:17
msgid ""
"Enable parallel (orthographic) projection instead of perspective "
"projection. Default is False."
msgstr ""
"透视投影の代わりに平行（正射影）投影を有効にします。デフォルトはFalse。"

#: of pyvista_wasm.camera.Camera:20
msgid "Camera elevation angle in degrees. Default is 0.0."
msgstr "カメラの仰角（度）。デフォルトは0.0。"

#: of pyvista_wasm.Camera.clipping_range:10 pyvista_wasm.Camera.elevation:15
#: pyvista_wasm.Camera.focal_point:10
#: pyvista_wasm.Camera.parallel_projection:15 pyvista_wasm.Camera.position:10
#: pyvista_wasm.Camera.view_angle:10 pyvista_wasm.Camera.view_up:10
#: pyvista_wasm.camera.Camera:24 pyvista_wasm.camera.Camera.azimuth:8
#: pyvista_wasm.camera.Camera.disable_parallel_projection:7
#: pyvista_wasm.camera.Camera.enable_parallel_projection:7
#: pyvista_wasm.camera.Camera.orbit_elevation:11
#: pyvista_wasm.camera.Camera.roll:7 pyvista_wasm.camera.Camera.zoom:11
msgid "Examples"
msgstr "例"

