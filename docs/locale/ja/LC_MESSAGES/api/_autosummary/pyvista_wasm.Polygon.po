#: ../api/_autosummary/pyvista_wasm.Polygon.rst:2
msgid "pyvista\\_wasm.Polygon"
msgstr "pyvista\\_wasm.Polygon"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Polygon:1
msgid "Create a regular polygon mesh in the xy plane."
msgstr "xy平面上に正多角形メッシュを作成します。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Polygon:3
msgid ""
"This mirrors the :func:`pyvista.Polygon` API. The geometry is generated with"
" NumPy because the vtk-wasm binary does not register a deserializer for "
"``vtkRegularPolygonSource``."
msgstr ""
":func:`pyvista.Polygon` APIと同等の動作です。vtk-"
"wasmバイナリは``vtkRegularPolygonSource``のデシリアライザーを登録していないため、ジオメトリはNumPyで生成されます。"

#: ../api/_autosummary/pyvista_wasm.Polygon.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Polygon:7
msgid "Radius of the circumscribed circle. Default is 1.0."
msgstr "外接円の半径。デフォルトは1.0。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Polygon:9
msgid "Number of sides (>= 3). Default is 6."
msgstr "辺の数（>= 3）。デフォルトは6。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Polygon:11
msgid "Center of the polygon (x, y, z). Default is (0, 0, 0)."
msgstr "多角形の中心 (x, y, z)。デフォルトは (0, 0, 0)。"

#: ../api/_autosummary/pyvista_wasm.Polygon.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Polygon:14
msgid "A polygon mesh."
msgstr "多角形メッシュ。"

#: ../api/_autosummary/pyvista_wasm.Polygon.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Polygon:18
msgid "Examples"
msgstr "例"
