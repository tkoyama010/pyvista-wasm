#: of pyvista_wasm.text.Text:1
msgid "A text annotation actor for 3D rendering."
msgstr ""

#: of pyvista_wasm.text.Text:3
msgid ""
"Wraps ``vtk.Rendering.Core.vtkTextActor`` to display 2D text overlays on "
"3D scenes. Text is positioned in normalized viewport coordinates (0 to 1 "
"in both x and y)."
msgstr ""

#: ../../api/_autosummary/pyvista_wasm.Text.rst
msgid "Parameters"
msgstr ""

#: of pyvista_wasm.text.Text:6
msgid ""
"Text string to be displayed. ``\"\\n\"`` is recognized as a line "
"separator. Characters must be UTF-8 encoded. Default is ``\"Text\"``."
msgstr ""

#: of pyvista_wasm.text.Text:9
msgid ""
"Position coordinate in normalized viewport space (x, y) where (0, 0) is "
"bottom-left and (1, 1) is top-right. Default is ``(0.5, 0.5)``."
msgstr ""

#: of pyvista_wasm.text.Text:12
msgid ""
"The property of this text actor controlling appearance. If ``None``, "
"creates a default TextProperty. Default is ``None``."
msgstr ""

#: of pyvista_wasm.text.Text:15
msgid ""
"The name of this actor used when tracking on a plotter. Default is "
"``None``."
msgstr ""

