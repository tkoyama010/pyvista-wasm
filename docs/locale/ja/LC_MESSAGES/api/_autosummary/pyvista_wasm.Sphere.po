#: ../api/_autosummary/pyvista_wasm.Sphere.rst:2
msgid "pyvista\\_wasm.Sphere"
msgstr "pyvista\\_wasm.Sphere"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:1
msgid "Create a sphere mesh."
msgstr "球メッシュを作成します。"

#: ../api/_autosummary/pyvista_wasm.Sphere.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:3
msgid "Sphere radius. Default is 1.0."
msgstr "球の半径。デフォルトは1.0。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:5
msgid "Center of the sphere (x, y, z). Default is (0, 0, 0)."
msgstr "球の中心 (x, y, z)。デフォルトは (0, 0, 0)。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:7
msgid "Number of points in the azimuthal direction. Default is 30."
msgstr "方位方向のポイント数。デフォルトは30。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:9
msgid "Number of points in the polar direction. Default is 30."
msgstr "極方向のポイント数。デフォルトは30。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:11
msgid ""
"If True, generate UV texture coordinates on the sphere. Default is False."
msgstr "True の場合、球にUVテクスチャ座標を生成します。デフォルトはFalse。"

#: ../api/_autosummary/pyvista_wasm.Sphere.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:14
msgid "A sphere mesh."
msgstr "球メッシュ。"

#: ../api/_autosummary/pyvista_wasm.Sphere.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:18
msgid "Examples"
msgstr "例"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Sphere:27
msgid "Create a sphere with texture coordinates for applying globe textures:"
msgstr "グローブテクスチャを適用するためのテクスチャ座標付き球体を作成します:"
