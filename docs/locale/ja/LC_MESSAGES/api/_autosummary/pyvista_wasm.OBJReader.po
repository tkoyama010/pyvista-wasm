#: ../api/_autosummary/pyvista_wasm.OBJReader.rst:2
msgid "pyvista\\_wasm.OBJReader"
msgstr "pyvista\\_wasm.OBJReader"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.OBJReader:1
msgid "Reader for Wavefront OBJ files (``.obj``)."
msgstr "Wavefront OBJファイルのリーダー（``.obj``）。"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.OBJReader:3
msgid ""
"Reads an OBJ ASCII file and produces a :class:`Mesh` that delegates parsing "
"to VTK.wasm's ``vtkOBJReader`` at render time. Python extracts only the "
"vertex coordinates so that camera framing and bounding-sphere queries work "
"before rendering."
msgstr ""
"OBJ ASCIIファイルを読み込み、レンダリング時に VTK.wasm の ``vtkOBJReader`` に解析を委譲する "
":class:`Mesh` を生成します。Python "
"は頂点座標のみを抽出するため、カメラフレーミングとバウンディングスフィアのクエリがレンダリング前に機能します。"

