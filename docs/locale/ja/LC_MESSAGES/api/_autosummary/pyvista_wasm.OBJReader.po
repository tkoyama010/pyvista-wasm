#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.OBJReader.read:3
msgid ""
"The full file content is base64-encoded and stored so that VTK.wasm can "
"parse it at render time.  Vertex coordinates are extracted on the Python "
"side for bounding-sphere and camera-framing calculations."
msgstr ""
"ファイルの全内容はbase64エンコードされて保存され、VTK.wasm "
"がレンダリング時に解析できます。頂点座標はバウンディングスフィアとカメラフレーミングの計算のためにPython 側で抽出されます。"

#: ../../src/pyvista_wasm/readers.pydocstring of
#: pyvista_wasm.readers.OBJReader.read:7
msgid "A mesh backed by the OBJ file content."
msgstr "OBJファイルコンテンツによってバッキングされたメッシュ。"

