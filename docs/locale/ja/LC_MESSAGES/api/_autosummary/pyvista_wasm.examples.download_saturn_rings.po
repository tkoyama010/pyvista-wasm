msgid "Examples"
msgstr "例"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.download_saturn_rings:30
msgid "Render Saturn's rings in the browser."
msgstr "ブラウザで土星の環をレンダリングします。"
