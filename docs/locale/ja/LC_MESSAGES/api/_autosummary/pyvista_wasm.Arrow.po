#: of pyvista_wasm.mesh.Arrow:1
msgid "Create an arrow mesh."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:3
msgid ""
"Returns a :class:`PolyData` representing an arrow starting at ``start`` "
"and pointing in ``direction``, backed by VTK.wasm ``vtkArrowSource``."
msgstr ""

#: ../../api/_autosummary/pyvista_wasm.Arrow.rst
msgid "Parameters"
msgstr ""

#: of pyvista_wasm.mesh.Arrow:6
msgid "Starting point of the arrow ``(x, y, z)``. Default is ``(0, 0, 0)``."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:8
msgid "Direction vector of the arrow. Default is ``(1, 0, 0)``."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:10
msgid ""
"Length of the conical tip as a fraction of the total arrow length. "
"Default is 0.25."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:13
msgid "Radius of the base of the tip. Default is 0.1."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:15
msgid "Number of faces around the tip cone. Default is 20."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:17
msgid "Radius of the cylindrical shaft. Default is 0.05."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:19
msgid "Number of faces around the shaft cylinder. Default is 20."
msgstr ""

#: of pyvista_wasm.mesh.Arrow:21
msgid ""
"Scaling factor applied to the entire arrow. When ``None`` the arrow is "
"not scaled."
msgstr ""

