#: ../api/_autosummary/pyvista_wasm.Disc.rst:2
msgid "pyvista\\_wasm.Disc"
msgstr "pyvista\\_wasm.Disc"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:1
msgid "Create a disc (annular ring) geometric primitive."
msgstr "ディスク（環状リング）の幾何プリミティブを作成します。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:3
msgid ""
"This mirrors the :func:`pyvista.Disc` API.  The geometry is built directly "
"from ``(r_res + 1)`` rings of ``c_res`` points each, connected as triangles,"
" so it renders correctly in VTK.wasm without depending on any specific "
"VTK.wasm source filter."
msgstr ""
"これは :func:`pyvista.Disc` API をミラーリングします。ジオメトリは ``c_res`` 個のポイントからなる ``(r_res"
" + 1)`` 個のリングから直接構築され、三角形として接続されるため、特定の VTK.wasm ソースフィルタに依存せずに VTK.wasm "
"で正しくレンダリングされます。"

#: ../api/_autosummary/pyvista_wasm.Disc.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:8
msgid "Center of the disc (x, y, z). Default is (0, 0, 0)."
msgstr "ディスクの中心 (x, y, z)。デフォルトは (0, 0, 0)。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:10
msgid "Inner radius of the disc. Default is 0.25."
msgstr "ディスクの内半径。デフォルトは0.25。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:12
msgid "Outer radius of the disc. Default is 0.5."
msgstr "ディスクの外半径。デフォルトは0.5。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:14
msgid "Normal vector of the disc. Default is (0, 0, 1)."
msgstr "ディスクの法線ベクトル。デフォルトは (0, 0, 1)。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:16
msgid "Number of radial subdivisions. Default is 1."
msgstr "半径方向の細分割数。デフォルトは1。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:18
msgid "Number of circumferential subdivisions. Default is 6."
msgstr "円周方向の細分割数。デフォルトは6。"

#: ../api/_autosummary/pyvista_wasm.Disc.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Disc:21
msgid "A disc (annular ring) mesh."
msgstr "ディスク（環状リング）メッシュ。"

#: ../api/_autosummary/pyvista_wasm.Disc.rst:0
msgid "Return type"
msgstr "戻り値の型"

