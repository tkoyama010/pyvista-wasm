msgid "pyvista\\_wasm.PLYReader"
msgstr "pyvista\\_wasm.PLYReader"

#: of pyvista_wasm.readers.PLYReader:1
msgid "Reader for PLY (Polygon File Format) files (``.ply``)."
msgstr "PLY（Polygon File Format）ファイルのリーダー（``.ply``）。"

#: of pyvista_wasm.readers.PLYReader:3
msgid ""
"Reads a PLY ASCII file and produces a :class:`Mesh` that delegates "
"parsing to VTK.wasm's ``vtkPLYReader`` at render time. Python extracts "
"only the vertex coordinates so that camera framing and bounding-sphere "
"queries work before rendering."
msgstr ""
"PLY ASCIIファイルを読み込み、レンダリング時に VTK.wasm の ``vtkPLYReader`` に"
"解析を委譲する :class:`Mesh` を生成します。Python は頂点座標のみを抽出するため、"
"カメラフレーミングとバウンディングスフィアのクエリがレンダリング前に機能します。"

