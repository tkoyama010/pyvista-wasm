#: ../api/_autosummary/pyvista_wasm.examples.load_earth.rst:2
msgid "pyvista\\_wasm.examples.load\\_earth"
msgstr "pyvista\\_wasm.examples.load\\_earth"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:1
msgid "Load the planet Earth as a textured sphere."
msgstr "テクスチャ付き球体として地球をロードします。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:3
msgid ""
"Creates a sphere mesh with texture coordinates, matching the "
"``pyvista.examples.planets.load_earth`` API. The sphere is rotated 180° "
"around the Z axis to align the Prime Meridian correctly."
msgstr ""
"テクスチャ座標付きの球体メッシュを作成します。``pyvista.examples.planets.load_earth`` API "
"と一致します。球体はZ軸を中心に180°回転して本初子午線を正しく整列させます。"

#: ../api/_autosummary/pyvista_wasm.examples.load_earth.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:7
msgid "Sphere radius. Default is 1.0."
msgstr "球体の半径。デフォルトは 1.0。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:9
msgid "Number of points in the latitude direction. Default is 50."
msgstr "緯度方向のポイント数。デフォルトは 50。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:11
msgid "Number of points in the longitude direction. Default is 100."
msgstr "経度方向のポイント数。デフォルトは 100。"

#: ../api/_autosummary/pyvista_wasm.examples.load_earth.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:14
msgid "Earth sphere mesh with texture coordinates."
msgstr "テクスチャ座標付き地球球体メッシュ。"

#: ../api/_autosummary/pyvista_wasm.examples.load_earth.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:19
msgid ":func:`~pyvista_wasm.examples.download_earth_surface`"
msgstr ":func:`~pyvista_wasm.examples.download_earth_surface`"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:20
msgid "Download the Earth surface texture."
msgstr "地球表面のテクスチャをダウンロードします。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:22
msgid ":func:`~pyvista_wasm.examples.download_mars_surface`"
msgstr ":func:`~pyvista_wasm.examples.download_mars_surface`"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_earth:23
msgid "Download the Mars surface texture for comparison."
msgstr "比較のために火星表面のテクスチャをダウンロードします。"

