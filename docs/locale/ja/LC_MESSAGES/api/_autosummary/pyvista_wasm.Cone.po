#: ../api/_autosummary/pyvista_wasm.Cone.rst:2
msgid "pyvista\\_wasm.Cone"
msgstr "pyvista\\_wasm.Cone"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:1
msgid "Create a cone mesh."
msgstr "円錐メッシュを作成します。"

#: ../api/_autosummary/pyvista_wasm.Cone.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:3
msgid "Center of the cone (x, y, z). Default is (0, 0, 0)."
msgstr "円錐の中心 (x, y, z)。デフォルトは (0, 0, 0)。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:5
msgid "Direction vector of the cone axis. Default is (1, 0, 0)."
msgstr "円錐の軸の方向ベクトル。デフォルトは (1, 0, 0)。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:7
msgid "Height of the cone. Default is 1.0."
msgstr "円錐の高さ。デフォルトは1.0。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:9
msgid "Base radius of the cone. Default is 0.5."
msgstr "円錐の底面の半径。デフォルトは0.5。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:11
msgid "Number of facets around the cone. Default is 6."
msgstr "円錐の周囲の面数。デフォルトは6。"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:13
msgid "Whether to cap the base of the cone. Default is True."
msgstr "円錐の底面をキャップするかどうか。デフォルトはTrue。"

#: ../api/_autosummary/pyvista_wasm.Cone.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:16
msgid "A cone mesh."
msgstr "円錐メッシュ。"

#: ../api/_autosummary/pyvista_wasm.Cone.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_wasm/mesh.pydocstring of pyvista_wasm.mesh.Cone:20
msgid "Examples"
msgstr "例"
