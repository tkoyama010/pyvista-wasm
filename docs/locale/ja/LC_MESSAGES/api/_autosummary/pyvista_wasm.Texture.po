#: ../api/_autosummary/pyvista_wasm.Texture.rst:2
msgid "pyvista\\_wasm.Texture"
msgstr "pyvista\\_wasm.Texture"

#: ../../src/pyvista_wasm/texture.pydocstring of
#: pyvista_wasm.texture.Texture:1
msgid "Surface texture wrapping an image URL."
msgstr "画像URLをラップするサーフェステクスチャ。"

#: ../../src/pyvista_wasm/texture.pydocstring of
#: pyvista_wasm.texture.Texture:3
msgid ""
"Mirrors the PyVista :class:`pyvista.Texture` API for browser-based rendering"
" via VTK.wasm. A texture is applied to a mesh by passing it to "
":meth:`~pyvista_wasm.Plotter.add_mesh` as the ``texture`` argument."
msgstr ""
"VTK.wasm を介したブラウザベースのレンダリング用に PyVista の :class:`pyvista.Texture` API "
"をミラーリングします。テクスチャは ``texture`` 引数として :meth:`~pyvista_wasm.Plotter.add_mesh` "
"に渡すことでメッシュに適用されます。"

#: ../api/_autosummary/pyvista_wasm.Texture.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/texture.pydocstring of
#: pyvista_wasm.texture.Texture:7
msgid "URL of the image to use as a texture (PNG, JPEG, etc.)."
msgstr "テクスチャとして使用する画像のURL（PNG, JPEG など）。"

#: ../../src/pyvista_wasm/texture.pydocstring of
#: pyvista_wasm.texture.Texture:11
msgid "Examples"
msgstr "例"

