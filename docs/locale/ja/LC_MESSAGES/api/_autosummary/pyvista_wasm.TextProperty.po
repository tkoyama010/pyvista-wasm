#: ../api/_autosummary/pyvista_wasm.TextProperty.rst:2
msgid "pyvista\\_wasm.TextProperty"
msgstr "pyvista\\_wasm.TextProperty"

#: ../../src/pyvista_wasm/text.pydocstring of pyvista_wasm.text.TextProperty:1
msgid "Properties for text rendering."
msgstr "テキストレンダリングのプロパティ。"

#: ../../src/pyvista_wasm/text.pydocstring of pyvista_wasm.text.TextProperty:3
msgid ""
"Provides control over text appearance including font size, color, and "
"opacity."
msgstr "フォントサイズ、色、不透明度を含むテキストの外観を制御します。"

#: ../api/_autosummary/pyvista_wasm.TextProperty.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/text.pydocstring of pyvista_wasm.text.TextProperty:5
msgid "Font size in points. Default is ``18``."
msgstr "フォントサイズ（ポイント）。デフォルトは ``18``。"

#: ../../src/pyvista_wasm/text.pydocstring of pyvista_wasm.text.TextProperty:7
msgid ""
"RGB color with values between 0 and 1, or a color name. Default is white."
msgstr "0から1の値を持つ RGB 色、または色名。デフォルトは白。"

#: ../../src/pyvista_wasm/text.pydocstring of pyvista_wasm.text.TextProperty:9
msgid ""
"Text opacity between 0 (transparent) and 1 (opaque). Default is ``1.0``."
msgstr "テキストの不透明度。0（透明）から1（不透明）の間。デフォルトは ``1.0``。"

#: ../../src/pyvista_wasm/text.pydocstring of
#: pyvista_wasm.text.TextProperty:11
msgid "Enable bold text. Default is ``False``."
msgstr "太字テキストを有効にします。デフォルトは ``False``。"

#: ../../src/pyvista_wasm/text.pydocstring of
#: pyvista_wasm.text.TextProperty:13
msgid "Enable italic text. Default is ``False``."
msgstr "イタリックテキストを有効にします。デフォルトは ``False``。"

#: ../../src/pyvista_wasm/text.pydocstring of
#: pyvista_wasm.text.TextProperty:17
msgid "Examples"
msgstr "例"

#: ../api/_autosummary/pyvista_wasm.TextProperty.rst:16:<autosummary>:1
#: ../../src/pyvista_wasm/text.pydocstring of
#: pyvista_wasm.text.TextProperty.__init__:1
msgid "Initialize a TextProperty instance."
msgstr "TextPropertyインスタンスを初期化します。"

