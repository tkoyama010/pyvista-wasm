msgid "pyvista\\_wasm.examples.load\\_saturn"
msgstr "pyvista\\_wasm.examples.load\\_saturn"

#: of pyvista_wasm.examples.load_saturn:1
msgid "Load the planet Saturn as a textured sphere."
msgstr "テクスチャ付き球体として土星を読み込みます。"

#: of pyvista_wasm.examples.load_saturn:3
msgid ""
"Creates a sphere mesh with texture coordinates, matching the "
"``pyvista.examples.planets.load_saturn`` API. The sphere is rotated 180° "
"around the Z axis to align the Prime Meridian correctly."
msgstr ""
"``pyvista.examples.planets.load_saturn`` API "
"と一致する、テクスチャ座標を持つ球体メッシュを作成します。本初子午線を正しく合わせるため、球体はZ軸周りに180°回転されます。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_saturn.rst
msgid "Parameters"
msgstr "パラメータ"

#: of pyvista_wasm.examples.load_saturn:7
msgid "Sphere radius. Default is 1.0."
msgstr "球体の半径。デフォルトは1.0です。"

#: of pyvista_wasm.examples.load_saturn:9
msgid "Number of points in the latitude direction. Default is 50."
msgstr "緯度方向の点の数。デフォルトは50です。"

#: of pyvista_wasm.examples.load_saturn:11
msgid "Number of points in the longitude direction. Default is 100."
msgstr "経度方向の点の数。デフォルトは100です。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_saturn.rst
msgid "Returns"
msgstr "戻り値"

#: of pyvista_wasm.examples.load_saturn:14
msgid "Saturn sphere mesh with texture coordinates."
msgstr "テクスチャ座標を持つ土星の球体メッシュ。"

#: ../../api/_autosummary/pyvista_wasm.examples.load_saturn.rst
msgid "Return type"
msgstr "戻り値の型"

#: of pyvista_wasm.examples.load_saturn:19
