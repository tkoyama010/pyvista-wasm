#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn:1
msgid "Load the planet Saturn as a textured sphere."
msgstr "テクスチャ付き球体として土星をロードします。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn:3
msgid ""
"Creates a sphere mesh with texture coordinates, matching the "
"``pyvista.examples.planets.load_saturn`` API. The sphere is rotated 180° "
"around the Z axis to align the Prime Meridian correctly."
msgstr ""
" ``pyvista.examples.planets.load_saturn`` API "
"と同じ、テクスチャ座標付きの球体メッシュを作成します。本初子午線を正しく合わせるため、球体はZ軸周りに180°回転しています。"

#: ../api/_autosummary/pyvista_wasm.examples.load_saturn.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn:7
msgid "Sphere radius. Default is 1.0."
msgstr "球体の半径。デフォルトは 1.0。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn:9
msgid "Number of points in the latitude direction. Default is 50."
msgstr "緯度方向のポイント数。デフォルトは 50。"

#: ../../src/pyvista_wasm/examples.pydocstring of
#: pyvista_wasm.examples.load_saturn:11
msgid "Number of points in the longitude direction. Default is 100."
msgstr "経度方向のポイント数。デフォルトは 100。"

