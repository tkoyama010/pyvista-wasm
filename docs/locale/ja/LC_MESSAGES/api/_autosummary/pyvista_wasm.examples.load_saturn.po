msgstr ":func:`~pyvista_wasm.examples.load_saturn_rings`"

#: of pyvista_wasm.examples.load_saturn:20
msgid "Load the planet Saturn's rings."
msgstr "土星の環を読み込みます。"

#: of pyvista_wasm.examples.load_saturn:22
msgid ":func:`~pyvista_wasm.examples.download_saturn_surface`"
msgstr ":func:`~pyvista_wasm.examples.download_saturn_surface`"

#: of pyvista_wasm.examples.load_saturn:23
msgid "Download the Saturn surface texture."
msgstr "土星の表面テクスチャをダウンロードします。"

