{
  "name": "pyvista-wasm",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["slidev.slidev", "yzhang.markdown-all-in-one"]
    }
  },
  "forwardPorts": [3030],
  "portsAttributes": {
    "3030": {
      "label": "Slidev dev server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
  "remoteUser": "node"
}
